{
  "name": "dsh-github-login",
  "productName": "DSH GitHub Login",
  "version": "1.0.1",
  "description": "GitHub 可视化登录：独立 Electron 工具 + DSH 宿主端插件（dsh plugin add 安装）",
  "main": "main.js",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "github-login"
  ],
  "author": "Noob-stupid",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dsh.github.login",
    "productName": "DSH GitHub Login",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DSH-GitHub-Login.exe"
    }
  }
}
